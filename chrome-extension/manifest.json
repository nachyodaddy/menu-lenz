{
  "manifest_version": 3,
  "name": "Antigravity IDE & Menu LENZ Companion",
  "version": "1.0.0",
  "description": "Chrome Extension for Antigravity IDE and Menu LENZ: Instant web recipe OCR capture, My25 portal ingestion helper, and side panel meal canvas.",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open Antigravity Menu LENZ Helper"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
